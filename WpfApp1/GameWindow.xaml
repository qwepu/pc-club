<Window x:Class="CyberClubManager.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}"
        Title="Змейка" Width="460" Height="570" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="ScoreText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Border Style="{StaticResource Card}" Padding="0" HorizontalAlignment="Center">
            <Canvas x:Name="GameCanvas" Width="400" Height="400" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True"/>
        </Border>
        <TextBlock Text="Стрелки или WASD, Esc — выход" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </StackPanel>
</Window>
