<Window x:Class="CyberClubManager.EditWindow" Style="{StaticResource WindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <StackPanel x:Name="FieldsPanel"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="4,10,4,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" MinWidth="90"/>
            <Button Content="Отмена" IsCancel="True" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
