<Window x:Class="CyberClubManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}"
        Title="CyberClub Manager" Height="740" Width="1200" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="24,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выйти" Click="Logout_Click"/>
                <StackPanel DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="RoleText" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
                <TextBlock Text="CyberClub" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="Tabs" Margin="24,12,24,16"/>
    </DockPanel>
</Window>
