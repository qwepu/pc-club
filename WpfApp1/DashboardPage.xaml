<UserControl x:Class="CyberClubManager.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click"/>
                <TextBlock Text="Сегодня в клубе" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
            </DockPanel>
            <WrapPanel x:Name="CardsPanel"/>
            <WrapPanel Margin="0,8,0,0">
                <Border Style="{StaticResource Card}" Width="560">
                    <StackPanel>
                        <TextBlock Text="Сейчас играют" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="ActiveGrid" IsReadOnly="True" AutoGenerateColumns="True" MaxHeight="260"
                                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="460">
                    <StackPanel>
                        <TextBlock Text="Заканчивается на складе" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="LowStockGrid" IsReadOnly="True" AutoGenerateColumns="True" MaxHeight="260"
                                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
