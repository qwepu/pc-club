<Window x:Class="CyberClubManager.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}"
        Title="Смена пароля" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="28,24">
        <TextBlock Text="Смена пароля" FontSize="20" FontWeight="Bold" Margin="4,0,4,8"/>
        <TextBlock Text="Текущий пароль" Style="{StaticResource LabelText}"/>
        <PasswordBox x:Name="OldBox" MaxLength="64"/>
        <TextBlock Text="Новый пароль (не короче 6 символов)" Style="{StaticResource LabelText}"/>
        <PasswordBox x:Name="NewBox" MaxLength="64"/>
        <TextBlock Text="Повтор нового пароля" Style="{StaticResource LabelText}"/>
        <PasswordBox x:Name="RepeatBox" MaxLength="64"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="4,10,4,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" IsCancel="True"/>
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
