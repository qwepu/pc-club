<UserControl x:Class="CyberClubManager.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="Изменить данные" Click="EditProfile_Click"/>
                            <Button Content="Сменить пароль" Click="ChangePassword_Click"/>
                        </StackPanel>
                        <Grid Width="64" Height="64" Margin="0,0,18,0">
                            <Ellipse Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="InitialsText" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="RoleText" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            <TextBlock x:Name="ContactText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <WrapPanel x:Name="StatsPanel"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Мои последние сеансы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="SessionsGrid" IsReadOnly="True" AutoGenerateColumns="True" MaxHeight="260"
                                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="SecretSpot" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Width="18" Height="18" Background="Transparent" MouseLeftButtonDown="Secret_Click"/>
    </Grid>
</UserControl>
