<Window x:Class="CyberClubManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowStyle}"
        Title="CyberClub Manager" Height="580" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Border Background="White" CornerRadius="16" Margin="32" Padding="32,28" VerticalAlignment="Center"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.10"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="CyberClub" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Войдите, чтобы продолжить" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,24"/>
                <TextBlock Text="Логин" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="LoginBox" MaxLength="50"/>
                <TextBlock Text="Пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="PasswordInput" MaxLength="64"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                <Button Content="Войти" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Login_Click" Margin="4,16,4,4"/>
                <Button Content="Создать аккаунт" Click="Register_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
