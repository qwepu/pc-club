<Window x:Class="CyberClubManager.OrderCreateWindow" Style="{StaticResource WindowStyle}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый заказ" Height="600" Width="940"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Товары в наличии" FontWeight="Bold" FontSize="14"/>
        <TextBlock Grid.Column="1" Text="Ваш заказ" FontWeight="Bold" FontSize="14"/>

        <DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="0,4,6,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding category}"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat=N2}"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding quantity_in_stock}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="CartGrid" Grid.Row="1" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="6,4,0,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="4"/>
            <TextBox x:Name="QtyBox" Text="1" Width="60"/>
            <Button Content="Добавить в заказ →" Click="AddToCart_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <Button Content="Убрать выбранное" Click="Remove_Click"/>
            <TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="12,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <TextBlock Text="Комментарий к заказу (необязательно)" Margin="4,0"/>
            <TextBox x:Name="CommentBox" MaxLength="500"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Оформить заказ" Style="{StaticResource PrimaryButton}" Click="Place_Click" MinWidth="120"/>
                <Button Content="Отмена" IsCancel="True" MinWidth="90"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
